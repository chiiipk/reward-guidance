text.usetex: False

font.family: sans-serif
font.sans-serif: Lato, DejaVu Sans
font.size: 15

axes.labelsize: 16
axes.titlesize: 16
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False

xtick.labelsize: 13
ytick.labelsize: 13
xtick.direction: in
ytick.direction: in
xtick.major.width: 0.8
ytick.major.width: 0.8

lines.linewidth: 1.5

legend.fontsize: 13
legend.frameon: False

figure.figsize: 8, 6
figure.dpi: 150

savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.05
